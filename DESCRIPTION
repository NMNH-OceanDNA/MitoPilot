Package: MitoPilot
Title: Mitogenome assembly, annotation, and curation
Version: 1.5.10
Authors@R: c(
    person("Devin", "Leopold", , "devin.leopold@gmail.com", role = c("aut")),
    person("Dan", "MacGuigan", , "macguigand@si.edu", role = c("aut", "cre"))
